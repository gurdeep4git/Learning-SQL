--Select full_name and email from customers and order_id, status, and total_amount from orders for 
--all customers who have placed an order. Alias customers as c and orders as o.
select c.full_name, c.email, o.order_id, o.status, o.total_amount
from customers c
join orders o on c.customer_id = o.customer_id

-- Find all customers who have NEVER placed an order. Display their full_name and email.
select *
from customers c
left join orders o on c.customer_id = o.customer_id
where o.order_id is NULL

--Calculate the total revenue spent by each customer across all their orders. Display full_name and the calculated sum as total_spent. 
--Order the results from highest spender to lowest spender.
select c.full_name, SUM(o.total_amount) as total_spent
from customers c 
left join orders o on c.customer_id = o.customer_id
GROUP BY c.full_name
order by total_spent desc

-- Display full_name, order_id, total_amount, and order_date for all orders that are currently in 'PENDING' status.
select c.full_name, o.order_id, o.total_amount, o.order_date
from orders o
join customers c on o.customer_id = c.customer_id
where o.status = 'PENDING'

-- Find all customers who have placed more than 1 order. Display full_name and the order count as order_count.
select c.full_name, COUNT(o.order_id) as order_count
from customers c
left join orders o on c.customer_id = o.customer_id
group by c.full_name
having COUNT(o.order_id) > 1



-- Write a query to display full_name, email, order_id, and order_date for all orders placed after '2026-07-20'.
select c.full_name, c.email, o.order_id, o.order_date
from orders o
left join customers c on o.customer_id = c.customer_id
where o.order_date > '2026-07-20'

--Display full_name, order_id, and total_amount for all orders, sorted by total_amount descending. 
--Ensure that customers who have not placed any orders are also included in the output.
select c.full_name, o.order_id, o.total_amount
from customers as c
left join orders as o
on o.customer_id = c.customer_id
order by o.total_amount desc

--Display the full_name of each customer alongside the total number of orders they have placed. Name the count column total_orders.
--Include customers who have zero orders in the result.
select c.full_name, COUNT(o.order_id) as total_orders
from customers as c
left join orders as o
on o.customer_id = c.customer_id
group by c.full_name

-- Find the single highest order amount (total_amount) placed by each customer. 
-- Display full_name and the maximum amount as highest_order_value. Exclude customers who have no orders.
select c.full_name, MAX(o.total_amount) as highest_order_value
from customers as c
join orders as o
on o.customer_id = c.customer_id
group by c.full_name

-- Display full_name, order_id, and status for all orders that are currently 'CANCELLED'.
select c.full_name, o.order_id, o.status
from orders as o
left join customers as c
on o.customer_id = c.customer_id
where o.status = 'CANCELLED'

-- Find the average order value for each customer who has placed at least one order.
-- Display full_name and avg_order_value, rounded or formatted to 2 decimal places if applicable, 
-- ordered from highest average spending to lowest.
select c.full_name, ROUND(AVG(total_amount), 2) as avg_order_value
from customers as c
join orders as o
on o.customer_id = c.customer_id
group by c.full_name
order by avg_order_value desc

-- Find all customers who have at least one order with a status of 'SHIPPED'. 
-- Display unique customer full_name and email values without duplicates.
SELECT DISTINCT c.full_name, c.email
FROM customers c
JOIN orders o ON c.customer_id = o.customer_id
WHERE o.status = 'SHIPPED';

-- Write a query to calculate the total monetary amount of all 'SHIPPED' orders grouped by customer. 
-- Display full_name and shipped_total. Filter the output to show only customers whose shipped total exceeds $200.00.
select c.full_name, SUM(o.total_amount) as shipped_total
from orders as o
left join customers as c
on c.customer_id = o.customer_id
where o.status = 'SHIPPED'
group by c.full_name
having SUM(o.total_amount) > 200

-- Display full_name, email, order_id, status, and order_date for all orders, but only for customers whose email domain contains 'dailyplanet.com' or 'amazon.gov'.
select c.full_name, c.email, o.order_id, o.status, o.order_date
from orders as o
left join customers as c
on c.customer_id = o.customer_id
where c.email LIKE '%dailyplanet.com' OR c.email LIKE '%amazon.gov'

-- Select full_name, order_id, total_amount, and order_date for all orders placed between '2026-07-15' and '2026-07-30' inclusive. 
-- Order the results by order_date ascending.
select c.full_name, o.order_id, o.total_amount, o.order_date
from orders as o
join customers as c
on c.customer_id = o.customer_id
where o.order_date between '2026-07-15' AND '2026-07-30'
order by o.order_date asc


